FROM node:20-alpine AS build
WORKDIR /src
COPY package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
ARG VITE_API_BASE_URL=http://127.0.0.1:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build
# Reuse the validated modern nginx runtime base instead of the retired
# nginx 1.27/Alpine image with known fixable OS-package advisories.
FROM nginx:stable-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
# Keep demo builds usable without a proxy secret while accepting the same
# verified CA injection used by the production candidate when provided.
RUN --mount=type=secret,id=proxy_ca,required=false \\
    if [ -f /run/secrets/proxy_ca ]; then \\
      SSL_CERT_FILE=/run/secrets/proxy_ca apk upgrade --no-cache; \\
    else \\
      apk upgrade --no-cache; \\
    fi \\
    && apk del --no-network curl
COPY --from=build /src/dist /usr/share/nginx/html
COPY nginx.demo.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
