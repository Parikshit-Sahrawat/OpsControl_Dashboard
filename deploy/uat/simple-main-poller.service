[Unit]
Description=OpsControl UAT deploy from remote main (no SEC-06)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=opsremote
EnvironmentFile=/etc/opscontrol-uat-main-poller.conf
ExecStart=/usr/bin/bash /usr/local/lib/opscontrol/simple_main_poller.sh
TimeoutStartSec=1800
