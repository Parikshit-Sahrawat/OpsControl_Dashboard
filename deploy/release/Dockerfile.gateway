FROM nginx:stable-alpine@sha256:583b7f2fce1cdb8da5ad5c39ebd3c33b98b87d493190e548bdee1fa8c619c311
RUN --mount=type=secret,id=proxy_ca,required=true SSL_CERT_FILE=/run/secrets/proxy_ca apk upgrade --no-cache && apk del --no-network curl
COPY deploy/gateway/nginx.conf /etc/nginx/nginx.conf
# TLS keys/CA are runtime-owned inputs; never bake credentials into images.
EXPOSE 8443
