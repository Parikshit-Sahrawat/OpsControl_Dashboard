{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyEC2InstanceAndHealth",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus"],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyCloudWatchCPU",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricStatistics"],
      "Resource": "*"
    }
  ]
}
