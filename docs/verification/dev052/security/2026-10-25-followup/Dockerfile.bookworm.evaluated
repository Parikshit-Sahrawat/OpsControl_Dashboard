FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS dependencies
WORKDIR /build
COPY requirements*.txt bootstrap_pip.py pip-bootstrap.json ./
RUN --mount=type=secret,id=proxy_ca,required=true PIP_CERT=/run/secrets/proxy_ca \
    python bootstrap_pip.py
RUN --mount=type=secret,id=proxy_ca,required=true PIP_CERT=/run/secrets/proxy_ca \
    python -m pip install --no-cache-dir --prefix=/install -r requirements-providers.txt -r requirements-hosts.txt
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70 AS runtime_base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info /usr/local/lib/python3.12/ensurepip /root/.cache/pip \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
COPY --from=dependencies /install/ /usr/local/
WORKDIR /app
COPY app/ app/
COPY scripts/ scripts/
RUN chmod -R a+rX /app/app /app/scripts
USER 10001:10001
FROM runtime_base AS migration
USER 0
COPY migrations/ /app/migrations/
COPY alembic.ini /app/alembic.ini
RUN chmod -R a+rX /app/migrations /app/alembic.ini
USER 10001:10001
CMD ["python", "-m", "alembic", "upgrade", "head"]
FROM runtime_base AS runtime
EXPOSE 8000
# Schema maintenance is a separate approved operation; no runtime installer.
CMD ["python", "-m", "scripts.run_api"]
