CxQENc8AAAABONx8Yg","user":{"login":"blakerouse","id":3869671,"node_id":"MDQ6VXNlcjM4Njk2NzE=","avatar_url":"https://avatars.githubusercontent.com/u/3869671?u=5b72e79cc6798d21557a244b185225de06466a47&v=4","gravatar_id":"","url":"https://api.github.com/users/blakerouse","html_url":"https://github.com/blakerouse","followers_url":"https://api.github.com/users/blakerouse/followers","following_url":"https://api.github.com/users/blakerouse/following{/other_user}","gists_url":"https://api.github.com/users/blakerouse/gists{/gist_id}","starred_url":"https://api.github.com/users/blakerouse/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blakerouse/subscriptions","organizations_url":"https://api.github.com/users/blakerouse/orgs","repos_url":"https://api.github.com/users/blakerouse/repos","events_url":"https://api.github.com/users/blakerouse/events{/privacy}","received_events_url":"https://api.github.com/users/blakerouse/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/15680#pullrequestreview-5248941154","pull_request_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/15680","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/open-telemetry/opentelemetry-collector/pull/15680#pullrequestreview-5248941154"},"pull_request":{"href":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/15680"}},"is_copilot_code_review":false,"copilot_code_review_effort":null,"submitted_at":"2026-09-18T14:31:12Z","commit_id":"71c973d35a916bdc18b5eefebe2b9ee1318385ea"},{"id":5319189549,"node_id":"PRR_kwDOCxQENc8AAAABPQxkLQ","user":{"login":"dmitryax","id":6628631,"node_id":"MDQ6VXNlcjY2Mjg2MzE=","avatar_url":"https://avatars.githubusercontent.com/u/6628631?u=359adf65ed167de20271cddeac5a51190fc9e4aa&v=4","gravatar_id":"","url":"https://api.github.com/users/dmitryax","html_url":"https://github.com/dmitryax","followers_url":"https://api.github.com/users/dmitryax/followers","following_url":"https://api.github.com/users/dmitryax/following{/other_user}","gists_url":"https://api.github.com/users/dmitryax/gists{/gist_id}","starred_url":"https://api.github.com/users/dmitryax/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dmitryax/subscriptions","organizations_url":"https://api.github.com/users/dmitryax/orgs","repos_url":"https://api.github.com/users/dmitryax/repos","events_url":"https://api.github.com/users/dmitryax/events{/privacy}","received_events_url":"https://api.github.com/users/dmitryax/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't think the current behavior is incorrect or that this fix is needed.\r\n\r\nWe retain only the requests that failed because of the shutdown, and I believe this logic is right and has to stay as is. We don't wire the shutdown to the exporter context, so in-flight requests always run to completion. The shutdown can only interrupt the retry sender's backoff between attempts. When it does, the request stays in the persistent queue and is redelivered after a restart. If there are no retries left, or `retry_on_failure` isn't enabled, failed requests are expected to be dropped (and should be).\r\n\r\nAlso, the persistent queue stops reading on shutdown, so only the in-flight requests (at most `num_consumers`) are affected, not the entire backlog.\r\n\r\nI think the problem is specific to the Elasticsearch exporter, because it relies on internal retry logic instead of using the exporterhelper's `retry_on_failure`. Those internal retries aren't tied to the collector shutdown. We should look into other options to resolve this in the Elasticsearch exporter.","state":"CHANGES_REQUESTED","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/15680#pullrequestreview-5319189549","pull_request_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/15680","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/open-telemetry/opentelemetry-collector/pull/15680#pullrequestreview-5319189549"},"pull_request":{"href":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/15680"}},"is_copilot_code_review":false,"copilot_code_review_effort":null,"submitted_at":"2026-09-25T14:57:58Z","commit_id":"b2b18d219b9744a5f7eecfb543b213c27e06edce"}]