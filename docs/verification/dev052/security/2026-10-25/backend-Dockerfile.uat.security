FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements*.txt ./
RUN --mount=type=secret,id=proxy_ca,required=true PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r requirements-providers.txt -r requirements-hosts.txt
COPY alembic.ini .
COPY migrations/ migrations/
COPY app/ app/
COPY scripts/ scripts/
RUN chmod -R a+rX /app/app /app/scripts /app/migrations && useradd --uid 10001 --no-create-home app
USER 10001:10001
EXPOSE 8000
# Migration is an explicit, separately approved one-shot Compose service.
CMD ["python", "-m", "scripts.run_api"]
