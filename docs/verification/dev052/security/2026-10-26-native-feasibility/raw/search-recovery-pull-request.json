etry-collector/issues/15273/events","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/15273","id":4401135304,"node_id":"PR_kwDOCxQENc7ZQ93u","number":15273,"title":"[RFC] Batch processor migration","user":{"login":"jmacd","id":3629705,"node_id":"MDQ6VXNlcjM2Mjk3MDU=","avatar_url":"https://avatars.githubusercontent.com/u/3629705?v=4","gravatar_id":"","url":"https://api.github.com/users/jmacd","html_url":"https://github.com/jmacd","followers_url":"https://api.github.com/users/jmacd/followers","following_url":"https://api.github.com/users/jmacd/following{/other_user}","gists_url":"https://api.github.com/users/jmacd/gists{/gist_id}","starred_url":"https://api.github.com/users/jmacd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jmacd/subscriptions","organizations_url":"https://api.github.com/users/jmacd/orgs","repos_url":"https://api.github.com/users/jmacd/repos","events_url":"https://api.github.com/users/jmacd/events{/privacy}","received_events_url":"https://api.github.com/users/jmacd/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":3509290933,"node_id":"LA_kwDOCxQENc7RK4e1","url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/labels/Skip%20Changelog","name":"Skip Changelog","color":"852AD3","default":false,"description":"PRs that do not require a CHANGELOG.md entry","archived_at":null,"archived_by":null},{"id":7616809385,"node_id":"LA_kwDOCxQENc8AAAABxf9JqQ","url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/labels/rfc:final-comment-period","name":"rfc:final-comment-period","color":"C2E0C6","default":false,"description":"This RFC is in the final comment period phase","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-05-07T18:37:46Z","updated_at":"2026-06-10T22:47:00Z","closed_at":"2026-06-10T18:20:14Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/15273","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/15273","diff_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/15273.diff","patch_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/15273.patch","merged_at":"2026-06-10T18:20:14Z"},"body":"#### Description\r\n\r\nDocuments a migration strategy for the batch processor in three phases.\r\n\r\nDeprecates and removes `batchprocessor`. Creates a new `queuebatchprocessor` with exporterhelper-derived processor capabilities and config matching the exporterhelper except with `wait_for_result: true` and `block_on_overflow: true` matching the original processor.\r\n\r\nUses a feature flag to set `batch::enabled` true by default for exporterhelper users. We estimate switching to Beta in v0.164.0 in the same release where batchprocessor is removed from the core and contrib release manifest. The core and feature flag will be removed finally October 2026.\r\n\r\nPart of #8222, #13766.\r\n","reactions":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/15273/reactions","total_count":5,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":4,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/15273/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13126","repository_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector","labels_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13126/labels{/name}","comments_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13126/comments","events_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13126/events","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13126","id":3108555697,"node_id":"PR_kwDOCxQENc6YirIC","number":13126,"title":"Migrate legacy queue metadata to a consolidated format and update related tests","user":{"login":"malus2077","id":88357654,"node_id":"MDQ6VXNlcjg4MzU3NjU0","avatar_url":"https://avatars.githubusercontent.com/u/88357654?v=4","gravatar_id":"","url":"https://api.github.com/users/malus2077","html_url":"https://github.com/malus2077","followers_url":"https://api.github.com/users/malus2077/followers","following_url":"https://api.github.com/users/malus2077/following{/other_user}","gists_url":"https://api.github.com/users/malus2077/gists{/gist_id}","starred_url":"https://api.github.com/users/malus2077/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/malus2077/subscriptions","organizations_url":"https://api.github.com/users/malus2077/orgs","repos_url":"https://api.github.com/users/malus2077/repos","events_url":"https://api.github.com/users/malus2077/events{/privacy}","received_events_url":"https://api.github.com/users/malus2077/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":11,"created_at":"2025-06-02T05:00:42Z","updated_at":"2025-07-10T09:19:19Z","closed_at":"2025-07-10T09:18:37Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/13126","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13126","diff_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13126.diff","patch_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13126.patch","merged_at":null},"body":"This PR updates the persistence strategy to consolidate all relevant queue information (start, stop, in-progress, size) under a single key for each write operation.\r\n\r\n- Fixes #12890\r\n- Relates to #13047 (Sub-PR)","reactions":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13126/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13126/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13246","repository_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector","labels_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13246/labels{/name}","comments_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13246/comments","events_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13246/events","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13246","id":3166032661,"node_id":"PR_kwDOCxQENc6bji5n","number":13246,"title":"[exporterhelper] Support mixed sizer types in persistent queue without draining","user":{"login":"malus2077","id":88357654,"node_id":"MDQ6VXNlcjg4MzU3NjU0","avatar_url":"https://avatars.githubusercontent.com/u/88357654?v=4","gravatar_id":"","url":"https://api.github.com/users/malus2077","html_url":"https://github.com/malus2077","followers_url":"https://api.github.com/users/malus2077/followers","following_url":"https://api.github.com/users/malus2077/following{/other_user}","gists_url":"https://api.github.com/users/malus2077/gists{/gist_id}","starred_url":"https://api.github.com/users/malus2077/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/malus2077/subscriptions","organizations_url":"https://api.github.com/users/malus2077/orgs","repos_url":"https://api.github.com/users/malus2077/repos","events_url":"https://api.github.com/users/malus2077/events{/privacy}","received_events_url":"https://api.github.com/users/malus2077/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-06-22T15:07:15Z","updated_at":"2025-07-06T02:02:45Z","closed_at":"2025-07-06T02:02:38Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/pulls/13246","html_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13246","diff_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13246.diff","patch_url":"https://github.com/open-telemetry/opentelemetry-collector/pull/13246.patch","merged_at":null},"body":"## Summary\r\nImplements non-blocking queue handling for sizer configuration changes by embedding item size information directly into queue items, eliminating the need to drain queues when switching between different sizer types.\r\n\r\n## Problem Statement\r\n- Addresses issue #12890\r\n- Previously, required complete queue drainage when changing sizer configuration. #13126\r\n\r\n## Solution\r\n- Embed `itemSize` in each queue item using new `QueueItem` protobuf message\r\n- Consolidate metadata storage from multiple keys to single `qmv0` key\r\n- Implement backward-compatible migration from legacy format\r\n- Remove obsolete `SizerType` tracking\r\n\r\n## Breaking Changes\r\nNone - Fully backward compatible with automatic migration\r\n\r\n## Testing\r\n- [x] Mixed sizer type handling test  \r\n- [x] Legacy format migration test\r\n- [x] Corrupted data recovery test\r\n- [x] Concurrent access test\r\n\r\n## Performance Impact\r\n- Minimal: +8 bytes per queue item for size storage\r\n- Improved: Reduced storage operations via metadata consolidation\r\n- Tradeoff: Slight serialization overhead vs operational flexibility","reactions":{"url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open-telemetry/opentelemetry-collector/issues/13246/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0}],"search_type":"lexical"}