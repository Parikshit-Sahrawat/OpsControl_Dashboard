FROM otel/opentelemetry-collector-contrib:0.123.0@sha256:e39311df1f3d941923c00da79ac7ba6269124a870ee87e3c3ad24d60f8aee4d2 AS telemetryruntime
FROM python:3.12.16-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=telemetryruntime /otelcol-contrib /usr/local/bin/otelcol-contrib
ENV OPSCONTROL_OTEL_BINARY=/usr/local/bin/otelcol-contrib
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements*.txt bootstrap_pip.py pip-bootstrap.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python bootstrap_pip.py && python -m pip install --no-cache-dir -r requirements-providers.txt -r requirements-hosts.txt
# Patch OS packages; no installer is shipped in this runtime candidate.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip && rm -rf /usr/local/lib/python3.12/ensurepip /root/.cache/pip \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12
COPY alembic.ini .
COPY migrations/ migrations/
COPY app/ app/
COPY scripts/ scripts/
RUN chmod -R a+rX /app/app /app/scripts /app/migrations && useradd --uid 10001 --no-create-home app
USER 10001:10001
EXPOSE 8000
# Migration is an explicit, separately approved one-shot Compose service.
CMD ["python", "-m", "scripts.run_api"]
