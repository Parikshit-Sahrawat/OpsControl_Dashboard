DATABASE_URL=postgresql+psycopg://opscontrol:opscontrol@localhost:5432/opscontrol
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
SEED_DEMO_DATA=true

# Local development credential provider example (do not commit real secrets)
# OPSC... names are derived from collector credential_ref values.
OPSCONTROL_CREDENTIAL_PROD_API_USERNAME=api-user
OPSCONTROL_CREDENTIAL_PROD_API_PASSWORD=change-me
