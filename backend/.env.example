DATABASE_URL=postgresql+psycopg://opscontrol:opscontrol@localhost:5432/opscontrol
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
SEED_DEMO_DATA=false

# Local development credential provider example (do not commit real secrets)
# OPSC... names are derived from collector credential_ref values.
OPSCONTROL_ALLOWED_CREDENTIAL_REFS=
OPSCONTROL_CREDENTIAL_DEV_API_USERNAME=
OPSCONTROL_CREDENTIAL_DEV_API_PASSWORD=

# Alert notification provider examples (leave unset to keep notifications disabled)
OPSCONTROL_PAGERDUTY_ROUTING_KEY=
OPSCONTROL_SMTP_HOST=
OPSCONTROL_SMTP_PORT=587
OPSCONTROL_SMTP_USERNAME=
OPSCONTROL_SMTP_PASSWORD=
OPSCONTROL_ALERT_EMAIL_FROM=
OPSCONTROL_ALERT_EMAIL_TO=
OPSCONTROL_SERVICENOW_URL=
OPSCONTROL_SERVICENOW_USERNAME=
OPSCONTROL_SERVICENOW_PASSWORD=
OPSCONTROL_SERVICENOW_TABLE=incident
OPSCONTROL_SERVICENOW_ASSIGNMENT_GROUP=
OPSCONTROL_SERVICENOW_RESOLVED_STATE=6
OPSCONTROL_SERVICENOW_CORRELATION_FIELD=correlation_id

# Exact ingress IPs/CIDRs are required with the supported production entrypoint.
TRUSTED_PROXY_IPS=
COLLECTOR_MAX_CONCURRENCY=4
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
OPSCONTROL_SERVICENOW_CREDENTIAL_REF=
OPSCONTROL_SERVICENOW_CLOSE_CODE=
