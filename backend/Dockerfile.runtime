FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS dependencies
WORKDIR /build
COPY requirements*.txt ./
RUN --mount=type=secret,id=proxy_ca,required=true PIP_CERT=/run/secrets/proxy_ca \
    python -m pip install --no-cache-dir pip==26.2
RUN --mount=type=secret,id=proxy_ca,required=true PIP_CERT=/run/secrets/proxy_ca \
    python -m pip install --no-cache-dir --prefix=/install -r requirements-providers.txt -r requirements-hosts.txt
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip && rm -rf /usr/local/lib/python3.12/ensurepip /root/.cache/pip
COPY --from=dependencies /install/ /usr/local/
WORKDIR /app
COPY app/ app/
COPY scripts/ scripts/
RUN chmod -R a+rX /app/app /app/scripts
USER 10001:10001
EXPOSE 8000
# Schema maintenance is a separate approved operation; no runtime installer.
CMD ["python", "-m", "scripts.run_api"]
